# --- API server -------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Where messages (messages.jsonl) and anonymous counters (stats.json) are stored.
DATA_DIR=data
# Built frontend to serve with SPA fallback. Set to "false" to run the API only.
# STATIC_DIR=dist
# Serve the blog live from this folder: posts in blog/, pictures and videos in media/. Add or edit a
# post there and it's on the site within seconds, no rebuild needed (the Docker image uses /content).
# CONTENT_DIR=content
# Set to 1 only behind a reverse proxy you control (uses X-Forwarded-For for rate limiting).
# TRUST_PROXY=1
# Only needed if the frontend is hosted on another origin, e.g. https://peterbodnar.example
# CORS_ORIGINS=
# Submissions faster than this (ms after the form appeared) are treated as bots.
# MIN_FORM_MS=2500

# --- Contact form email delivery (optional) ----------------------------------
# Without SMTP, every summit-book entry is still saved to DATA_DIR/messages.jsonl.
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Frontend (build time) ---------------------------------------------------
# Only when the API lives on another origin than the static site.
# VITE_API_BASE=https://api.peterbodnar.example
