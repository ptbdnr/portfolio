# Copy to .env.local for development, or provide as a compose env_file in prod.
# .env* is gitignored — never commit real secrets. Do NOT prefix any of these
# with NEXT_PUBLIC_ (that would expose them to the browser).

# ---- Auth (Auth.js / OAuth) ----
# Comma-separated admin emails. Anyone who signs in with one of these gets admin
# (sees drafts, can edit, export/import). Everyone else is a regular reader.
ADMIN_EMAILS=you@example.com
# Secret used to sign session tokens. Long random string, e.g. openssl rand -base64 48
AUTH_SECRET=generate-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: https://<your-host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (Azure app registration).
# Redirect URI: https://<your-host>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Tenant issuer: a tenant id, or "common" for any Microsoft account.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# ---- Landing-page chat (LangChain, provider-agnostic) ----
# Which provider to use: "anthropic" or "openai".
LLM_PROVIDER=anthropic
# Only the key for the chosen provider is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (otherwise a sensible per-provider default is used).
LLM_MODEL=

# ---- Storage ----
# Where the SQLite DB + backups live. Defaults to ./data locally; /data in Docker.
DATA_DIR=/data
