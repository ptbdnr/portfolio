# --- Auth.js core ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical public URL; required behind a reverse proxy / tunnel.
AUTH_URL=https://your-domain.tld
# Trust the X-Forwarded-* headers set by the proxy/tunnel.
AUTH_TRUST_HOST=true

# --- OAuth providers (OpenID Connect) ---
# Google Cloud Console → Credentials → OAuth client (Web application).
# Authorized redirect URI: https://your-domain.tld/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (Azure AD) app registration.
# Redirect URI: https://your-domain.tld/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Tenant: 'common' for multi-tenant + personal Microsoft accounts.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Authorization ---
# Comma-separated admin allowlist. Change here + restart to change the admin.
ADMIN_EMAILS=ptbdnr@gmail.com

# --- Database ---
# SQLite file. Point at a mounted NAS volume in production, e.g. file:/data/portfolio.db
DATABASE_URL=file:./data/portfolio.db
