{
  "name": "hut-to-hut",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "node scripts/media-privacy.ts && tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "image:nas": "docker build --platform linux/amd64 -t hut2hut:latest . && docker save hut2hut:latest -o hut2hut.tar",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "panoramas": "node scripts/panoramas.ts",
    "map": "node scripts/build-map.ts",
    "media": "node scripts/make-media.ts",
    "media:check": "node scripts/media-privacy.ts",
    "media:clean": "node scripts/media-privacy.ts --clean"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "hast-util-to-text": "^4.0.3",
    "highlight.js": "^11.11.2",
    "hono": "^4.13.17",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Peter Bodnar — a first-person walk through 360° photographs, from the sea to an Alpine summit: about me, a blog (Markdown with pictures, sound and video) and a summit book (contact).",
  "engines": {
    "node": ">=22.18"
  }
}
